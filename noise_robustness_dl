axes[0].set_title('Original Class Distribution (4-class)')
axes[0].set_ylabel('Count')
for i, v in enumerate(orig_counts.values):
    axes[0].text(i, v + 30, str(v), ha='center', fontweight='bold')

# Binary
bin_counts = df['y_bin'].value_counts().sort_index()
axes[1].bar(['Normal', 'Seizure'], bin_counts.values, color=['steelblue', 'red'])
axes[1].set_title('Binary Class Distribution')
axes[1].set_ylabel('Count')
for i, v in enumerate(bin_counts.values):
    axes[1].text(i, v + 30, str(v), ha='center', fontweight='bold')

plt.tight_layout()
plt.savefig(f"{OUTPUT_DIR}/class_distribution.png", dpi=150)
plt.close()
print(f"\nSaved: {OUTPUT_DIR}/class_distribution.png")

# =============================================================================
# STEP 3: MODEL DEFINITIONS
# =============================================================================

def build_mlp(n_features):
    model = models.Sequential([
        layers.Input(shape=(n_features,)),
        layers.Dense(256, activation='relu'),
        layers.BatchNormalization(), layers.Dropout(0.3),
        layers.Dense(128, activation='relu'),
        layers.BatchNormalization(), layers.Dropout(0.3),
        layers.Dense(64,  activation='relu'),
        layers.Dropout(0.2),
        layers.Dense(1, activation='sigmoid')
    ], name='MLP')
    return model


def build_cnn1d(n_features):
    model = models.Sequential([
        layers.Input(shape=(n_features, 1)),
        layers.Conv1D(128, kernel_size=3, padding='same', activation='relu'),
        layers.BatchNormalization(),
        layers.Dropout(0.3),
        layers.Conv1D(256, kernel_size=3, padding='same', activation='relu'),
        layers.BatchNormalization(),
        layers.Dropout(0.3),
        layers.Conv1D(128, kernel_size=3, padding='same', activation='relu'),
        layers.BatchNormalization(),
        layers.GlobalAveragePooling1D(),
        layers.Dense(128, activation='relu'),
        layers.Dropout(0.4),
        layers.Dense(64,  activation='relu'),
        layers.Dropout(0.3),
        layers.Dense(1, activation='sigmoid')
    ], name='CNN_1D')
    return model


def build_lstm(n_features):
    model = models.Sequential([
        layers.Input(shape=(n_features, 1)),
        layers.Bidirectional(layers.LSTM(128, return_sequences=True)),
        layers.Dropout(0.3),
        layers.Bidirectional(layers.LSTM(64, return_sequences=False)),
        layers.Dropout(0.3),
        layers.Dense(64, activation='relu'),
        layers.Dropout(0.2),
        layers.Dense(1, activation='sigmoid')
    ], name='BiLSTM')
    return model


def build_cnn_lstm(n_features):
    model = models.Sequential([
        layers.Input(shape=(n_features, 1)),
        layers.Conv1D(128, kernel_size=3, padding='same', activation='relu'),
        layers.BatchNormalization(),
        layers.Dropout(0.3),
        layers.Conv1D(64, kernel_size=3, padding='same', activation='relu'),
        layers.BatchNormalization(),
        layers.Dropout(0.3),
        layers.Bidirectional(layers.LSTM(64, return_sequences=False)),
        layers.Dropout(0.3),
        layers.Dense(32, activation='relu'),
        layers.Dense(1, activation='sigmoid')
    ], name='CNN_BiLSTM_Hybrid')
    return model


def build_gru(n_features):
    model = models.Sequential([
        layers.Input(shape=(n_features, 1)),
        layers.Bidirectional(layers.GRU(128, return_sequences=True)),
        layers.Dropout(0.3),
        layers.Bidirectional(layers.GRU(64, return_sequences=False)),
        layers.Dropout(0.3),
        layers.Dense(64, activation='relu'),
        layers.Dropout(0.2),
        layers.Dense(1, activation='sigmoid')
    ], name='BiGRU')
    return model


def build_transformer(n_features, num_heads=4, ff_dim=128, num_blocks=2):
    inputs = layers.Input(shape=(n_features, 1))
    x = inputs

    # Positional embedding via Dense projection
    x = layers.Dense(64)(x)   # project to d_model=64

    for _ in range(num_blocks):
        # Multi-Head Self-Attention
        attn_out = layers.MultiHeadAttention(
            num_heads=num_heads, key_dim=16, dropout=0.1
        )(x, x)
        x = layers.Add()([x, attn_out])          # residual
        x = layers.LayerNormalization(epsilon=1e-6)(x)

        # Feed-Forward block
        ff_out = layers.Dense(ff_dim, activation='relu')(x)
        ff_out = layers.Dropout(0.1)(ff_out)
        ff_out = layers.Dense(64)(ff_out)
        x = layers.Add()([x, ff_out])            # residual
        x = layers.LayerNormalization(epsilon=1e-6)(x)

    x = layers.GlobalAveragePooling1D()(x)
    x = layers.Dense(64, activation='relu')(x)
    x = layers.Dropout(0.3)(x)
    outputs = layers.Dense(1, activation='sigmoid')(x)

    model = keras.Model(inputs, outputs, name='Transformer')
    return model


# =============================================================================
# STEP 4: TRAINING & EVALUATION HELPERS
# =============================================================================

def train_model(model, X_tr, X_v, y_tr, y_v, model_name):
    model.compile(
        optimizer=optimizers.Adam(learning_rate=LR, clipnorm=1.0),
        loss='binary_crossentropy',
        metrics=['accuracy',
                 keras.metrics.AUC(name='auc'),
                 keras.metrics.Precision(name='precision'),
                 keras.metrics.Recall(name='recall')]
    )

    cb_list = [
        callbacks.EarlyStopping(monitor='val_auc', patience=PATIENCE,
                                restore_best_weights=True, verbose=1,
                                mode='max'),
        callbacks.ReduceLROnPlateau(monitor='val_loss', factor=0.5,
                                    patience=5, verbose=0)
    ]

    print(f"\nTraining {model_name}...")
    model.summary()

    hist = model.fit(
        X_tr, y_tr,
        validation_data=(X_v, y_v),
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,
        callbacks=cb_list,
        class_weight=class_weight_dict,
        verbose=1
    )

    history = {
        'train_loss' : hist.history['loss'],
        'val_loss'   : hist.history['val_loss'],
        'train_acc'  : hist.history['accuracy'],
        'val_acc'    : hist.history['val_accuracy'],
        'train_auc'  : hist.history['auc'],
        'val_auc'    : hist.history['val_auc'],
    }
    return model, history


def evaluate_model(model, X_input, y_true, model_name):
    y_pred_prob = model.predict(X_input, verbose=0).flatten()
    y_pred      = (y_pred_prob >= 0.5).astype(int)

    acc  = accuracy_score(y_true, y_pred)
    prec = precision_score(y_true, y_pred, zero_division=0)
    rec  = recall_score(y_true, y_pred, zero_division=0)
    f1   = f1_score(y_true, y_pred, zero_division=0)
    auc  = roc_auc_score(y_true, y_pred_prob)

    print(f"\n{'='*50}")
    print(f"{model_name} — Test Results")
    print(f"{'='*50}")
    print(f"  Accuracy  : {acc*100:.2f}%")
    print(f"  Precision : {prec*100:.2f}%")
    print(f"  Recall    : {rec*100:.2f}%")
    print(f"  F1-Score  : {f1*100:.2f}%")
    print(f"  AUC-ROC   : {auc*100:.2f}%")
    print(f"\nClassification Report:\n")
    print(classification_report(y_true, y_pred,
          target_names=['Normal', 'Seizure']))

    return {'Model': model_name, 'Accuracy': acc, 'Precision': prec,
            'Recall': rec, 'F1_Score': f1, 'AUC_ROC': auc,
            'y_pred': y_pred, 'y_pred_prob': y_pred_prob}


def save_confusion_matrix(y_true, y_pred, model_name, filename):
    cm = confusion_matrix(y_true, y_pred)
    plt.figure(figsize=(6, 5))
    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',
                xticklabels=['Normal', 'Seizure'],
                yticklabels=['Normal', 'Seizure'])
    plt.title(f'Confusion Matrix — {model_name}', fontsize=13)
    plt.ylabel('Actual'); plt.xlabel('Predicted')
    plt.tight_layout()
    plt.savefig(f"{OUTPUT_DIR}/{filename}", dpi=150)
    plt.close()
    print(f"Saved: {OUTPUT_DIR}/{filename}")


def save_training_history(history, model_name, filename):
    fig, axes = plt.subplots(1, 3, figsize=(16, 4))

    axes[0].plot(history['train_acc'],  label='Train')
    axes[0].plot(history['val_acc'],    label='Val')
    axes[0].set_title(f'{model_name} — Accuracy')
    axes[0].set_xlabel('Epoch'); axes[0].set_ylabel('Accuracy')
    axes[0].legend()

    axes[1].plot(history['train_loss'], label='Train')
    axes[1].plot(history['val_loss'],   label='Val')
    axes[1].set_title(f'{model_name} — Loss')
    axes[1].set_xlabel('Epoch'); axes[1].set_ylabel('Loss')
    axes[1].legend()

    axes[2].plot(history['train_auc'],  label='Train')
    axes[2].plot(history['val_auc'],    label='Val')
    axes[2].set_title(f'{model_name} — AUC')
    axes[2].set_xlabel('Epoch'); axes[2].set_ylabel('AUC')
    axes[2].legend()

    plt.tight_layout()
    plt.savefig(f"{OUTPUT_DIR}/{filename}", dpi=150)
    plt.close()
    print(f"Saved: {OUTPUT_DIR}/{filename}")


